---
import Base from '../layouts/Base.astro';
import Multiline99 from '../components/Multiline99.astro';
import SectionRule from '../components/SectionRule.astro';
import ContactStrip from '../components/ContactStrip.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PersonCard from '../components/PersonCard.astro';
import { projects } from '../data/projects.js';
import { people } from '../data/people.js';
import { opening } from '../data/manifesto.js';

const selected = projects.slice(0, 3);
---

<Base
  title="FI99 — We create things."
  description="FI99 is an experimental studio. Websites, apps, software."
>
  <!-- Hero -->
  <section class="hero flex min-h-[calc(100svh-3.1rem)] flex-col justify-between border-b border-bone/20 px-4 pb-6 pt-8 sm:px-6 sm:pt-12">
    <h1 class="sr-only">FI99 — We create things.</h1>
    <!-- On phones the mark and the tagline read as one block with the strip
         pinned to the bottom; `sm:contents` dissolves this wrapper so wide
         screens keep the original three-way justify-between spread. -->
    <div class="sm:contents">
      <div class="hero-mark flex items-end justify-between gap-4" aria-hidden="true">
        <span class="hero-fi hero-snap font-display font-black uppercase leading-none tracking-tight">
          <span class="grad-text grad-scroll">FI</span>
        </span>
        <Multiline99 draw class="hero-99 crt-glow" />
      </div>
      <div class="mt-6 sm:mt-14">
        <p class="hero-snap font-display text-[clamp(1.375rem,3.5vw,3rem)] font-medium leading-tight">
          We create things.
        </p>
        <!-- TODO(fi99): [SUBLINE] — confirm this line, add a location if we want one -->
        <p class="hero-snap mt-4 font-mono text-xs tracking-[0.2em] text-bone/60 sm:text-sm">
          AN EXPERIMENTAL STUDIO.
        </p>
      </div>
    </div>
    <!-- The scroll cue is all that is left in this row, so it can show on
         phones too — and it keeps the hero anchored to the bottom there. -->
    <div class="hero-snap mt-6 flex items-center justify-end font-mono text-[11px] tracking-[0.16em] text-bone/50 sm:mt-10 sm:tracking-[0.25em]">
      <span aria-hidden="true">SCROLL ↓</span>
    </div>
  </section>

  <!-- Selected work -->
  <section class="px-0 py-16 sm:py-24" aria-labelledby="work-heading">
    <div class="px-4 sm:px-6">
      <SectionRule label="SELECTED WORK" />
      <h2
        id="work-heading"
        data-split
        class="mt-6 font-display text-[clamp(2rem,6vw,5rem)] font-black uppercase leading-none tracking-tight"
      >
        Selected work
      </h2>
    </div>
    <ul class="mt-10 list-none">
      {selected.map((project) => <ProjectRow project={project} />)}
    </ul>
    <div class="border-t border-bone/20 px-4 py-6 sm:px-6">
      <a
        href="/work"
        data-scramble
        class="-my-2 inline-block py-3 font-mono text-sm tracking-[0.2em] text-bone hover:text-magenta active:text-magenta"
      >
        ALL WORK →
      </a>
    </div>
  </section>

  <!-- Manifesto excerpt -->
  <section class="border-t border-bone/20 px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="manifesto-heading">
    <SectionRule label="MANIFESTO — EXCERPT" />
    <h2 id="manifesto-heading" class="sr-only">Manifesto</h2>
    <!-- Only the concession goes here. The principles are the reason to
         click through to /about. -->
    <p
      data-split
      class="mt-10 font-display text-[clamp(2rem,8vw,5.5rem)] font-black uppercase leading-none tracking-tight"
    >
      {opening.lead}
    </p>
    <p
      data-split
      class="mt-3 font-display text-[clamp(2rem,8vw,5.5rem)] font-black uppercase leading-none tracking-tight text-bone/50"
    >
      {opening.admission}
    </p>
    <p
      data-reveal
      class="mt-6 max-w-4xl text-[clamp(1.125rem,2.4vw,1.625rem)] font-medium leading-snug"
    >
      {opening.body[0]}
    </p>
    <a
      href="/about"
      data-scramble
      data-reveal
      class="mt-6 inline-block py-3 font-mono text-sm tracking-[0.2em] text-bone hover:text-magenta active:text-magenta"
    >
      READ THE REST →
    </a>
  </section>

  <!-- Team — the manifesto above says "a collective of people", so show them.
       Compact cut: no bios, since the full ones live on /team. -->
  <section class="border-t border-bone/20 py-16 sm:py-24" aria-labelledby="team-heading">
    <div class="px-4 sm:px-6">
      <SectionRule label="PERSONNEL" />
      <h2
        id="team-heading"
        data-split
        class="mt-6 font-display text-[clamp(2rem,6vw,5rem)] font-black uppercase leading-none tracking-tight"
      >
        The three of us
      </h2>
    </div>
    <ul class="mt-10 grid list-none grid-cols-1 border-t border-bone/20 sm:grid-cols-3">
      {people.map((person) => <PersonCard person={person} compact />)}
    </ul>
    <div class="border-t border-bone/20 px-4 py-6 sm:px-6">
      <a
        href="/team"
        data-scramble
        class="-my-2 inline-block py-3 font-mono text-sm tracking-[0.2em] text-bone hover:text-magenta active:text-magenta"
      >
        MEET THE TEAM →
      </a>
    </div>
  </section>

  <ContactStrip />
</Base>
