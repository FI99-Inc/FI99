---
import Base from '../layouts/Base.astro';
---

<Base title="404 — FI99" description="Nothing here. We're probably building it.">
  <section class="flex min-h-[calc(var(--vh100,1svh)*100-3.1rem)] flex-col justify-center overflow-x-clip px-4 py-16 sm:px-6">
    <p class="font-mono text-[11px] tracking-[0.25em] text-bone/50">
      [ ERROR 404 — SIGNAL LOST ]
    </p>
    <p
      class="glitch mt-4 font-display text-[clamp(6rem,32vw,26rem)] font-black leading-none tracking-tight"
      data-text="404"
      aria-hidden="true"
    >
      404
    </p>
    <h1 class="mt-8 max-w-2xl text-xl font-medium sm:text-3xl">
      Nothing here. We're probably building it.
    </h1>
    <a
      href="/"
      data-scramble
      class="mt-6 inline-block py-3 font-mono text-sm tracking-[0.2em] text-bone hover:text-magenta"
    >
      ← BACK TO FI99
    </a>
  </section>
</Base>
