---

<ul class="social-links flex items-stretch">
  {
    links.map((link) => (
      <li class="flex">
        <a
          href={link.href}
          target="_blank"
          rel="noopener"
          aria-label={`FI99 on ${link.label}`}
          class="flex items-center px-4 text-bone/55"
        >
          <svg
            viewBox={link.viewBox}
            class="h-4 w-4"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d={link.path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
