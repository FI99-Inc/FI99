---
// Loud full-width mailto strip. Inverted: bone panel, void text.
// TODO(fi99): [EMAIL] — confirm contact@fi99.ca once the address exists.
const email = 'contact@fi99.ca';
---

<section class="border-t border-bone/20" aria-labelledby="contact-heading">
  <div class="grad-rule"></div>
  <div class="bg-bone px-4 py-16 text-void sm:px-6 sm:py-24">
    <p class="mb-6 font-mono text-[11px] tracking-[0.25em] text-void/60">
      [ CONTACT — NO FORMS, JUST MAIL ]
    </p>
    <h2
      id="contact-heading"
      data-split
      class="font-display text-[clamp(2.25rem,7.5vw,7rem)] font-black uppercase leading-[0.95] tracking-tight"
    >
      Want something built?
    </h2>
    <a
      href={`mailto:${email}`}
      data-scramble
      class="mt-8 inline-block border-2 border-void px-5 py-4 font-mono text-sm tracking-[0.2em] hover:bg-void hover:text-bone sm:text-lg"
    >
      {email.toUpperCase()}
    </a>
  </div>
</section>
