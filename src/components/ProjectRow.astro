---
const { project, index } = Astro.props;

const num = String(index + 1).padStart(2, '0');
const isLink = Boolean(project.link);
const Tag = isLink ? 'a' : 'div';
const linkAttrs = isLink
  ? { href: project.link, target: '_blank', rel: 'noopener' }
  : {};
---

<li class="border-t border-bone/20" data-reveal>
  <Tag
    {...linkAttrs}
    class="group grid grid-cols-[3.5rem_1fr] items-baseline gap-x-4 gap-y-2 px-4 py-6 hover:bg-bone hover:text-void sm:grid-cols-[4rem_5fr_4fr_3fr] sm:px-6 sm:py-8"
  >
    <span class="font-mono text-xs tracking-widest text-bone/50 group-hover:text-void/60">
      {num}
    </span>
    <h3
      class="font-display text-2xl font-extrabold uppercase leading-none tracking-tight sm:text-4xl"
    >
      {project.name}
    </h3>
    <p class="col-start-2 text-sm text-bone/70 group-hover:text-void/80 sm:col-start-3 sm:text-base">
      {project.oneLiner}
    </p>
    <p
      class="col-start-2 font-mono text-[11px] tracking-[0.15em] sm:col-start-4 sm:text-right"
    >
      <span
        class:list={[
          project.status === 'shipped'
            ? 'text-magenta group-hover:text-void'
            : 'text-bone/60 group-hover:text-void/70',
        ]}
      >
        [{project.status.toUpperCase()}]
      </span>
      <span class="text-bone/60 group-hover:text-void/70">
        {' '}{project.year} · {project.tags.join(' · ').toUpperCase()}
      </span>
      {isLink && <span class="text-bone/60 group-hover:text-void"> · VIEW ↗</span>}
    </p>
  </Tag>
</li>
