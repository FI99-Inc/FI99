---
// Build-time starfield: tiny dots scattered across a fixed full-viewport
// SVG, sitting behind everything (see .starfield in global.css). Seeded
// PRNG so every build renders the same sky.
function mulberry32(seed) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(99);

// Mostly bone-white with the occasional faint brand-tinted star.
const TINTS = [
  '#f2efe9', '#f2efe9', '#f2efe9', '#f2efe9', '#f2efe9',
  '#cfc6ff', '#b9c8ff', '#ffd7ec',
];

const STAR_COUNT = 170;

// rand()*rand() biases radii toward the tiny end — a few brighter pinpricks
// in a field of near-dust, which is what a real sky looks like.
const stars = Array.from({ length: STAR_COUNT }, () => ({
  x: (rand() * 100).toFixed(2),
  y: (rand() * 100).toFixed(2),
  r: (0.4 + rand() * rand() * 1).toFixed(2),
  o: (0.15 + rand() * 0.65).toFixed(2),
  tint: TINTS[Math.floor(rand() * TINTS.length)],
  group: Math.floor(rand() * 3),
}));
---

<div class="starfield" aria-hidden="true">
  <svg width="100%" height="100%">
    {
      stars.map((s) => (
        <circle
          class={`star-g${s.group}`}
          cx={`${s.x}%`}
          cy={`${s.y}%`}
          r={s.r}
          fill={s.tint}
          fill-opacity={s.o}
        />
      ))
    }
  </svg>
</div>
