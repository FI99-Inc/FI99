---
import { Image } from 'astro:assets';

// `compact` is the home-page cut: portrait, name and school only. The full
// card adds the bio and the person's links, and is what /team renders.
const { person, compact = false } = Astro.props;
---

<li
  class="portrait-card flex flex-col border-b border-bone/20 px-4 py-8 sm:border-b-0 sm:border-r sm:px-6 sm:py-10 sm:last:border-r-0"
  data-reveal
>
  <div class="portrait-frame mb-6 aspect-square w-full border border-bone/20">
    {
      person.photo ? (
        <Image
          src={person.photo}
          alt={`${person.name}, photographed.`}
          widths={[320, 560]}
          sizes="(min-width: 40rem) 30vw, 92vw"
          class="portrait-img h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        /* Not a broken image — a deliberate empty slot, in the same
           filing-cabinet voice as the PERSONNEL rule above it. */
        <div class="flex h-full w-full items-center justify-center bg-bone/[0.03]">
          <span class="font-mono text-[10px] tracking-[0.25em] text-bone/30">
            [ NO PHOTO ON FILE ]
          </span>
        </div>
      )
    }
  </div>

  <h3 class="font-display text-2xl font-extrabold uppercase leading-none tracking-tight sm:text-3xl">
    {person.name}
  </h3>

  <!-- "TORONTO METROPOLITAN UNIVERSITY" at 0.2em runs to the very edge at
       390px and past it below that, so ease the tracking until there is room. -->
  <p class="mt-3 font-mono text-[11px] tracking-[0.12em] text-magenta sm:tracking-[0.2em]">
    [{person.school.toUpperCase()}]
  </p>

  {
    !compact && person.bio && (
      <p class="mt-4 text-sm leading-relaxed text-bone/70">{person.bio}</p>
    )
  }

  {
    !compact && person.links.length > 0 && (
      <ul class="mt-auto flex list-none flex-wrap gap-x-4 gap-y-1 pt-5">
        {person.links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              data-scramble
              class="inline-block py-1 font-mono text-[11px] tracking-[0.2em] text-bone/70 underline decoration-bone/30 underline-offset-4 hover:text-magenta hover:decoration-magenta active:text-magenta active:decoration-magenta"
            >
              {link.label} ↗
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>
