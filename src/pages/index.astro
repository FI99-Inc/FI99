---
import Base from '../layouts/Base.astro';
import Multiline99 from '../components/Multiline99.astro';
import SectionRule from '../components/SectionRule.astro';
import ContactStrip from '../components/ContactStrip.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PersonCard from '../components/PersonCard.astro';
import ResearchRow from '../components/ResearchRow.astro';
import { projects } from '../data/projects.js';
import { people } from '../data/people.js';
import { research } from '../data/research.js';
import { opening } from '../data/manifesto.js';

const selected = projects.slice(0, 3);
const manifestoExcerpt = `${opening.body[0].split(':')[0]}.`;
---

<Base
  title="FI99 · We create things."
  description="FI99 is a small studio for ambitious, unusual ideas. Websites, apps, software."
>
  <!-- Hero -->
  <section class="hero flex min-h-[calc(var(--vh100,1svh)*100-6rem)] flex-col justify-between border-b border-bone/20 px-4 pb-6 pt-8 sm:min-h-[calc(var(--vh100,1svh)*100-3.1rem)] sm:px-6 sm:pt-12">
    <!-- A faint 3D rocket behind the whole hero, not just the mark — it needs
         room to sit big and diagonal without being confined to the mark's own
         box. Mounted by scripts/rocketScene.js; see that file for why the
         heavy three.js code lives in a separately-imported module instead of
         here. -->
    <div class="hero-rocket-scene pointer-events-none absolute inset-0" data-rocket-scene aria-hidden="true"></div>
    <h1 class="sr-only">FI99. We create things.</h1>
    <!-- On phones the mark and the tagline read as one block with the strip
         pinned to the bottom; `sm:contents` dissolves this wrapper so wide
         screens keep the original three-way justify-between spread. -->
    <div class="sm:contents">
      <div class="hero-mark flex items-end justify-between gap-4" aria-hidden="true">
        <span class="hero-fi hero-snap font-display font-black uppercase leading-none tracking-tight">
          {/* data-ripple only on the hero mark, not the header lockup: that
              one is the home link, and a navigation would cut the wave off
              a few frames in. */}
          <span class="grad-text grad-scroll" data-ripple>FI</span>
        </span>
        <Multiline99 draw class="hero-99 crt-glow" />
      </div>
      <div class="mt-6 sm:mt-14">
        {/* aria-hidden because the sr-only h1 above already carries this exact
            sentence — and because the last word rewrites itself every few
            seconds, which a screen reader has no good way to report. The
            markup ships "things.", which is what no-JS and reduced-motion
            visitors keep. */}
        <p
          class="hero-snap font-display text-[clamp(1.375rem,3.5vw,3rem)] font-medium leading-tight"
          aria-hidden="true"
        >
          We create <span class="hero-word" data-word-cycle>things.</span>
        </p>
        <p class="hero-snap mt-4 font-mono text-xs tracking-[0.2em] text-bone/60 sm:text-sm">
          A SMALL STUDIO FOR AMBITIOUS, UNUSUAL IDEAS.
        </p>
      </div>
    </div>
    <!-- The scroll cue is all that is left in this row, so it can show on
         phones too — and it keeps the hero anchored to the bottom there.
         A real button now, not decorative text — motion.js's scrollCue()
         wires the click to smoothscroll.js's scrollTo(), which routes
         through Lenis rather than fighting it with a native jump. -->
    <div class="hero-snap mt-6 flex items-center justify-end sm:mt-10">
      <button
        type="button"
        data-scroll-cue
        class="bg-transparent p-0 font-mono text-[11px] tracking-[0.16em] text-bone/50 transition-colors hover:text-bone focus-visible:text-bone sm:tracking-[0.25em]"
      >
        SCROLL ↓
      </button>
    </div>
  </section>

  <!-- The lab — the three projects that are worth showing -->
  <section id="lab" class="px-0 py-16 sm:py-24" aria-labelledby="work-heading">
    <div class="px-4 sm:px-6">
      <SectionRule />
      <h2
        id="work-heading"
        data-split
        class="mt-6 font-display text-[clamp(2rem,6vw,5rem)] font-black uppercase leading-none tracking-tight"
      >
        The Lab
      </h2>
    </div>
    <ul class="mt-10 list-none">
      {selected.map((project) => <ProjectRow project={project} />)}
    </ul>
    <div class="border-t border-bone/20 px-4 py-6 sm:px-6">
      <a
        href="/work"
        data-scramble
        class="-my-2 inline-block py-3 font-mono text-sm tracking-[0.2em] text-bone hover:text-magenta active:text-magenta"
      >
        ALL WORK →
      </a>
    </div>
  </section>

  <!-- R&D is evidence-facing, distinct from the product-facing lab, but it
       uses the lab's row scale so the two sections read as siblings. -->
  <section id="research" class="border-t border-bone/20 py-16 sm:py-24" aria-labelledby="research-heading">
    <div class="px-4 sm:px-6">
      <SectionRule />
      <h2
        id="research-heading"
        data-split
        class="mt-6 font-display text-[clamp(2rem,6vw,5rem)] font-black uppercase leading-none tracking-tight"
      >
        Research &amp; Development
      </h2>
    </div>
    <ul class="mt-10 list-none">
      {research.map((entry) => <ResearchRow entry={entry} />)}
    </ul>
    <div class="border-t border-bone/20 px-4 py-6 sm:px-6">
      <a
        href="/research"
        data-scramble
        class="-my-2 inline-block py-3 font-mono text-sm tracking-[0.2em] text-bone hover:text-magenta active:text-magenta"
      >
        ALL R&amp;D →
      </a>
    </div>
  </section>

  <!-- Manifesto excerpt. With no eyebrow above it, the quotation itself has
       to say "this is quoted from somewhere": a blockquote set off by the
       four-stroke rule turned on its side, an attribution line under it, and
       a link that says there is more. -->
  <section class="border-t border-bone/20 px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="manifesto-heading">
    <SectionRule />
    <h2 id="manifesto-heading" class="sr-only">From the manifesto</h2>
    <figure class="manifesto-quote mt-10 max-w-6xl">
      <svg class="manifesto-quote-rule" viewBox="0 0 17 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <rect x="0" y="0" width="2" height="100" fill="#ff1f8f" />
        <rect x="5" y="0" width="2" height="100" fill="#c525c7" />
        <rect x="10" y="0" width="2" height="100" fill="#8b2bff" />
        <rect x="15" y="0" width="2" height="100" fill="#4a25ff" />
      </svg>
      <blockquote>
        <p
          data-split
          class="font-display text-[clamp(2.75rem,6.8vw,6.5rem)] font-black uppercase leading-[0.92] tracking-tight"
        >
          {opening.lead}
        </p>
        <p
          data-split
          class="mt-2 font-display text-[clamp(2.75rem,6.8vw,6.5rem)] font-black uppercase leading-[0.92] tracking-tight text-bone/55"
        >
          {opening.admission}
        </p>
        <p
          data-reveal
          class="mt-10 max-w-2xl text-[clamp(1.25rem,2.1vw,1.625rem)] font-medium leading-snug text-bone/85"
        >
          {manifestoExcerpt}
        </p>
      </blockquote>
      <figcaption data-reveal class="mt-8 flex flex-wrap items-baseline gap-x-6 gap-y-2 font-mono text-sm tracking-[0.2em]">
        <cite class="not-italic text-bone/50">FI99 MANIFESTO, OPENING</cite>
        <a
          href="/about"
          data-scramble
          class="inline-block py-3 text-bone hover:text-magenta active:text-magenta"
        >
          READ THE REST →
        </a>
      </figcaption>
    </figure>
  </section>

  <!-- Team — the manifesto above says "a collective of people", so show them.
       Compact cut: no bios, since the full ones live on /team. -->
  <section class="border-t border-bone/20 py-16 sm:py-24" aria-labelledby="team-heading">
    <div class="px-4 sm:px-6">
      <SectionRule />
      <h2
        id="team-heading"
        data-split
        class="mt-6 font-display text-[clamp(2rem,6vw,5rem)] font-black uppercase leading-none tracking-tight"
      >
        The three of us
      </h2>
    </div>
    <ul class="mt-10 grid list-none grid-cols-1 border-t border-bone/20 sm:grid-cols-3">
      {people.map((person) => <PersonCard person={person} compact />)}
    </ul>
    <div class="border-t border-bone/20 px-4 py-6 sm:px-6">
      <a
        href="/team"
        data-scramble
        class="-my-2 inline-block py-3 font-mono text-sm tracking-[0.2em] text-bone hover:text-magenta active:text-magenta"
      >
        MEET THE TEAM →
      </a>
    </div>
  </section>

  <ContactStrip />
</Base>
