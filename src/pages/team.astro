---
import Base from '../layouts/Base.astro';
import SectionRule from '../components/SectionRule.astro';
import PersonCard from '../components/PersonCard.astro';
import { people } from '../data/people.js';
---

<Base
  title="Team — FI99"
  description="The three people behind FI99: Srihith Jarabana, Lars Fransen-Molino and Omar Badawy."
>
  <section class="py-12 sm:py-16" aria-labelledby="team-heading">
    <div class="px-4 sm:px-6">
      <SectionRule label="PERSONNEL" />
      <h2
        id="team-heading"
        data-split
        class="mt-6 font-display text-[clamp(2rem,10vw,8rem)] font-black uppercase leading-none tracking-tight"
      >
        The three of us
      </h2>
    </div>
    <ul class="mt-12 grid list-none grid-cols-1 border-t border-bone/20 sm:grid-cols-3">
      {people.map((person) => <PersonCard person={person} />)}
    </ul>
  </section>
</Base>
