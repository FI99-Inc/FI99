---
// Full-bleed gradient marquee. The track holds two identical halves; GSAP
// loops it to -50%. Reduced motion: it simply doesn't move.
const items = ['WEBSITES', 'APPS', 'SOFTWARE', 'EXPERIMENTS'];
const half = Array(3).fill(items).flat();
---

<div
  class="grad-bg scanlines overflow-hidden border-y border-void/60 py-3 sm:py-4"
  aria-hidden="true"
>
  <div class="ticker-track flex w-max whitespace-nowrap">
    {
      [0, 1].map(() => (
        <span class="block font-display text-2xl font-black uppercase leading-none text-void sm:text-4xl">
          {half.map((item) => (
            <span class="inline-block">
              {item}
              <span class="mx-4 inline-block sm:mx-6">/</span>
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>
