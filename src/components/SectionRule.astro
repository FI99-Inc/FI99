---
// Divider: a fragment of the multiline stroke pattern, then a hairline
// rule. Optional mono label reads like terminal metadata.
const { label = '', class: className = '' } = Astro.props;

const COLORS = ['#ff1f8f', '#c525c7', '#8b2bff', '#4a25ff'];
---

<div class:list={['flex items-center gap-4 sm:gap-6', className]} aria-hidden="true">
  <!-- The stroke fragment and the label are both shrink-0, so at 320px a
       96px rule plus a 22-character label pushed the page into horizontal
       scroll. Both ease off below sm, then return to full size. -->
  <svg viewBox="0 0 96 17" class="h-[17px] w-16 shrink-0 sm:w-24" fill="none">
    {
      COLORS.map((c, i) => (
        <rect x="0" y={i * 5} width="96" height="2" fill={c} />
      ))
    }
  </svg>
  {
    label && (
      <span class="shrink-0 font-mono text-[11px] tracking-[0.14em] text-bone/60 sm:tracking-[0.25em]">
        {label}
      </span>
    )
  }
  <span class="h-px min-w-0 flex-1 bg-bone/20"></span>
</div>
