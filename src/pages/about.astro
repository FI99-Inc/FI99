---
import Base from '../layouts/Base.astro';
import SectionRule from '../components/SectionRule.astro';
import { Image } from 'astro:assets';
import { opening, principles, closing } from '../data/manifesto.js';
import { people } from '../data/people.js';
import observantMan from '../../TheDreamer.png';

const OBSERVANT_WIDTHS = [360, 560, 900];

// The concession is the whole argument, so both halves of it are set as
// display type rather than body copy. The rest steps down to reading size.
---

<Base
  title="About — FI99"
  description="You are early. So are we. What FI99 holds to be true."
>
  <section class="py-12 sm:py-16" aria-labelledby="manifesto-heading">
    <div class="px-4 sm:px-6">
      <SectionRule label="MANIFESTO" />
      <h2
        id="manifesto-heading"
        data-split
        class="mt-6 font-display text-[clamp(2rem,10vw,8rem)] font-black uppercase leading-none tracking-tight"
      >
        Manifesto
      </h2>

      <p
        data-split
        class="mt-10 font-display text-[clamp(1.875rem,7.5vw,4.5rem)] font-black uppercase leading-none tracking-tight"
      >
        {opening.lead}
      </p>
      <p
        data-split
        class="mt-3 font-display text-[clamp(1.875rem,7.5vw,4.5rem)] font-black uppercase leading-none tracking-tight text-bone/50"
      >
        {opening.admission}
      </p>
      <div class="mt-8 lg:grid lg:grid-cols-[minmax(0,3fr)_minmax(17rem,1fr)] lg:items-start lg:gap-x-12">
        <div
          data-reveal
          class="max-w-3xl space-y-5 text-[clamp(1.0625rem,2vw,1.375rem)] leading-relaxed text-bone/80"
        >
          {opening.body.map((line) => <p>{line}</p>)}
        </div>
        <figure
          class="manifesto-portrait manifesto-portrait--desktop hidden lg:block"
          data-reveal
        >
          <div class="portrait-frame aspect-[4/5] border border-bone/20">
            <Image
              src={observantMan}
              alt="The observant man"
              widths={OBSERVANT_WIDTHS}
              sizes="(min-width: 64rem) 28vw, calc(100vw - 2rem)"
              class="portrait-img h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <Image
              src={observantMan}
              alt=""
              aria-hidden="true"
              widths={OBSERVANT_WIDTHS}
              sizes="(min-width: 64rem) 28vw, calc(100vw - 2rem)"
              class="portrait-color object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      </div>
    </div>

    <!-- Numbered rows rather than paragraphs: the repeated structure is what
         makes a line of this quotable on its own, and the bordered-row rhythm
         is the same one /work and /team already use. -->
    <ol class="mt-12 list-none border-b border-bone/20">
      {
        principles.map((principle, i) => (
          <li class="border-t border-bone/20" data-reveal>
            <div class="grid grid-cols-1 gap-y-3 px-4 py-6 sm:grid-cols-[auto_1fr] sm:items-start sm:gap-x-8 sm:px-6 sm:py-8">
              <span class="font-mono text-[11px] tracking-[0.25em] text-magenta sm:text-xs">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <div class="text-[clamp(1.25rem,3vw,2rem)] font-medium leading-snug">
                  {principle.statement
                    .split(/(?<=\.) /)
                    .map((line) => <p>{line}</p>)}
                </div>
                <p class="mt-3 max-w-2xl text-[clamp(1rem,1.8vw,1.1875rem)] leading-relaxed text-bone/70">
                  {principle.body}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="px-4 sm:px-6">
      <div
        data-reveal
        class="mt-12 max-w-3xl space-y-5 text-[clamp(1.0625rem,2vw,1.375rem)] leading-relaxed text-bone/80"
      >
        {closing.map((line) => <p>{line}</p>)}
      </div>

      <!-- Signed, because the closing line promises it is. Pulled from
           people.js so a fourth name never has to be added twice. -->
      <p class="mt-12 font-mono text-[11px] tracking-[0.25em] text-bone/50">
        SIGNED
      </p>
      <ul
        data-reveal
        class="mt-4 flex list-none flex-wrap gap-x-8 gap-y-2 font-mono text-[11px] tracking-[0.2em] text-bone/70 sm:text-xs"
      >
        {people.map((person) => <li>{person.name.toUpperCase()}</li>)}
      </ul>
      <figure
        class="manifesto-portrait manifesto-portrait--mobile mt-12 lg:hidden"
        data-reveal
      >
        <div class="portrait-frame aspect-[4/5] border border-bone/20">
          <Image
            src={observantMan}
            alt="The observant man"
            widths={OBSERVANT_WIDTHS}
            sizes="(min-width: 64rem) 28vw, calc(100vw - 2rem)"
            class="portrait-img h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <Image
            src={observantMan}
            alt=""
            aria-hidden="true"
            widths={OBSERVANT_WIDTHS}
            sizes="(min-width: 64rem) 28vw, calc(100vw - 2rem)"
            class="portrait-color object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </section>

  <div class="border-t border-bone/20 px-4 py-6 sm:px-6">
    <a
      href="/team"
      data-scramble
      data-reveal
      class="-my-2 inline-block py-3 font-mono text-sm tracking-[0.2em] text-bone hover:text-magenta active:text-magenta"
    >
      WHO WE ARE →
    </a>
  </div>
</Base>
