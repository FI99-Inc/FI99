---
import Base from '../../layouts/Base.astro';
import SectionRule from '../../components/SectionRule.astro';
import ResearchFeature from '../../components/ResearchFeature.astro';
import { research } from '../../data/research.js';
---

<Base
  title="R&D · FI99"
  description="FI99 research and development: VERDANT, a recommender built to prove itself wrong, and Temporal, a calendar that keeps facts apart from guesses."
>
  <section class="py-12 sm:py-16" aria-labelledby="research-heading">
    <div class="px-4 sm:px-6">
      <SectionRule />
      <!-- Sized a notch under /work's heading: DEVELOPMENT is long enough
           that 10vw pushes it past a 320px screen. -->
      <h1
        id="research-heading"
        data-split
        class="mt-6 font-display text-[clamp(1.75rem,7.6vw,8rem)] font-black uppercase leading-none tracking-tight"
      >
        Research &amp; Development
      </h1>
    </div>

    <div class="mt-12 border-b border-bone/20">
      {research.map((entry) => <ResearchFeature entry={entry} large headingLevel="h2" />)}
    </div>
  </section>
</Base>
