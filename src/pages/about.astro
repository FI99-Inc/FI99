---
import Base from '../layouts/Base.astro';
import SectionRule from '../components/SectionRule.astro';

// TODO(fi99): [FOUNDER_BIOS] — 2 sentences max each; the card hides the bio
// until one is set.
const founders = [
  {
    name: 'Srihith Jarabana',
    school: 'University of Toronto',
    bio: '',
    linkedin: 'https://www.linkedin.com/in/srihithjarabana/',
  },
  {
    name: 'Lars Fransen-Molino',
    school: 'Laurentian University',
    bio: '',
    linkedin: 'https://www.linkedin.com/in/lars-fransen-molino-901579287/',
  },
  {
    name: 'Omar Badawy',
    school: 'Toronto Metropolitan University',
    bio: '',
    linkedin: 'https://www.linkedin.com/in/omar-badawy-37834b255/',
  },
];
---

<Base
  title="About — FI99"
  description="FI99 is a collective of people who build things because the ideas would not leave us alone."
>
  <!-- Manifesto -->
  <section class="border-b border-bone/20 px-4 py-12 sm:px-6 sm:py-16" aria-labelledby="manifesto-heading">
    <SectionRule label="MANIFESTO — FULL TEXT" />
    <h2
      id="manifesto-heading"
      data-split
      class="mt-6 font-display text-[clamp(2rem,10vw,8rem)] font-black uppercase leading-none tracking-tight"
    >
      Manifesto
    </h2>
    <!-- TODO(fi99): placeholder manifesto — structure and length are right,
         rewrite the words in our own voice before launch -->
    <div
      data-reveal
      class="mt-10 max-w-5xl space-y-8 text-[clamp(1.375rem,3.2vw,2.5rem)] font-medium leading-snug"
    >
      <p>
        FI99 is a collective of people who build things because the ideas would
        not leave us alone. We view it as an opportunity to learn, and to
        explore a variety of categories.
      </p>
      <p>
        Some things we make are useful. Some are jokes that got out of hand.
        All of them ship.
      </p>
      <p>
        If you want something built, or you want to argue about whether it
        should exist, <a
          href="/#contact-heading"
          class="grad-text underline decoration-magenta underline-offset-4 hover:decoration-2">email us</a
        >.
      </p>
    </div>
  </section>

  <!-- The three of us -->
  <section class="py-12 sm:py-16" aria-labelledby="people-heading">
    <div class="px-4 sm:px-6">
      <SectionRule label="PERSONNEL — 03 ON FILE" />
      <h2
        id="people-heading"
        data-split
        class="mt-6 font-display text-[clamp(2rem,6vw,5rem)] font-black uppercase leading-none tracking-tight"
      >
        The three of us
      </h2>
    </div>
    <ul class="mt-12 grid list-none grid-cols-1 border-t border-bone/20 sm:grid-cols-3">
      {
        founders.map((founder) => (
          <li
            class="border-b border-bone/20 px-4 py-8 sm:border-b-0 sm:border-r sm:px-6 sm:py-10 sm:last:border-r-0"
            data-reveal
          >
            <h3 class="font-display text-2xl font-extrabold uppercase leading-none tracking-tight sm:text-3xl">
              {founder.name}
            </h3>
            <!-- "TORONTO METROPOLITAN UNIVERSITY" at 0.2em runs to the very
                 edge at 390px and past it below that, so ease the tracking
                 until there is room for it. -->
            <p class="mt-3 font-mono text-[11px] tracking-[0.12em] text-magenta sm:tracking-[0.2em]">
              [{founder.school.toUpperCase()}]
            </p>
            {founder.bio && (
              <p class="mt-4 text-sm leading-relaxed text-bone/70">{founder.bio}</p>
            )}
            {founder.linkedin && (
              <a
                href={founder.linkedin}
                target="_blank"
                rel="noopener"
                data-scramble
                class="mt-1 inline-block py-4 font-mono text-[11px] tracking-[0.2em] text-bone/70 underline decoration-bone/30 underline-offset-4 hover:text-magenta hover:decoration-magenta active:text-magenta active:decoration-magenta"
              >
                LINKEDIN ↗
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
