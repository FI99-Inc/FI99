---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Multiline99 from '../components/Multiline99.astro';
import Starfield from '../components/Starfield.astro';
import StatusReadout from '../components/StatusReadout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import displayFontUrl from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
// The body and mono faces paint the first screen too (tagline, nav, section
// rules), so they get the same treatment as the display face: preloaded
// rather than discovered through the CSS, which on a phone connection is the
// difference between text arriving set and text arriving twice.
import bodyFontUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import monoFontUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const {
  title = 'FI99 — We create things.',
  description = 'FI99 is an experimental studio. Websites, apps, software.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// NOTES is deliberately absent, not gone. The section is finished and still in
// the repo at src/pages/_notes/ — the leading underscore is what keeps Astro
// from building those routes at all, so there is no URL to stumble onto.
// Bringing it back is this line plus dropping that underscore.
// { href: '/notes', label: 'NOTES' },
const nav = [
  { href: '/work', label: 'WORK' },
  { href: '/team', label: 'TEAM' },
  { href: '/about', label: 'ABOUT' },
];

const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Phone browsers paint their own chrome around the page — address bar,
         tab strip, overscroll. Without this they frame the void in white. -->
    <meta name="theme-color" content="#060606" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href={displayFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={bodyFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={monoFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FI99" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // html.motion hides the hero and every [data-reveal] until GSAP reveals
      // them, so a motion bundle that never boots — script error, blocked or
      // slow network — would leave the page permanently blank. The hidden
      // state expires on its own; motion.js stamps motion-ready to cancel it.
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        function arm() {
          root.classList.add('motion');
          window.setTimeout(function () {
            if (!root.classList.contains('motion-ready')) {
              root.classList.remove('motion');
            }
          }, 2000);
        }
        arm();
        // A client-side navigation copies the incoming document's <html>
        // class list over this one, which drops `motion`. Re-arm per swap.
        document.addEventListener('astro:after-swap', function () {
          root.classList.remove('motion-ready');
          arm();
        });
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <!-- No background on body: html carries the void color, and painting it
       here again would sit on top of the z-index -1 starfield. -->
  <body class="font-sans text-bone">
    <Starfield />

    <!-- Duotone ramp for the portraits, defined once here because the cards
         appear on more than one page and three copies of the same filter id
         would collide. Luminance first, then a three-stop table landing
         shadows on void and highlights on bone. The point is not decoration:
         the source photos are a studio headshot, a phone snapshot taken at
         night and a bright seaside portrait, and putting all three through one
         ramp is what makes them read as one set rather than three strangers.
         Deliberately near-neutral — a saturated version reads as a photo
         filter and drowns the magenta school label beneath it. -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" class="absolute">
      <defs>
        <filter id="fi-duotone" color-interpolation-filters="sRGB">
          <feColorMatrix
            type="matrix"
            values="0.2126 0.7152 0.0722 0 0
                    0.2126 0.7152 0.0722 0 0
                    0.2126 0.7152 0.0722 0 0
                    0      0      0      1 0"
          />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.031 0.34 0.949" />
            <feFuncG type="table" tableValues="0.031 0.32 0.937" />
            <feFuncB type="table" tableValues="0.062 0.44 0.914" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
    <a
      href="#main"
      class="absolute left-4 top-4 z-50 -translate-y-24 bg-magenta px-4 py-2 font-mono text-xs uppercase tracking-widest text-void transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>

    <header class="border-b border-bone/20">
      <div class="flex items-stretch justify-between">
        <!-- Logo and readout are one group so justify-between still throws the
             nav to the right edge, and the readout sits against the logo's
             rule rather than floating in the middle of the bar. Reads as a
             label and its instrument. -->
        <div class="flex items-stretch">
          <a
            href="/"
            class="logo-lockup relative flex items-center gap-[0.12em] border-r border-bone/20 px-4 py-3 font-display text-lg font-black tracking-tight sm:px-6"
            aria-label="FI99 home"
          >
            <!-- Atomic-age orbits behind the mark. It comes first in the DOM so
                 the two positioned children after it paint on top. -->
            <svg
              class="logo-orbits"
              viewBox="-50 -30 100 60"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <ellipse cx="0" cy="0" rx="44" ry="15" transform="rotate(-32)" stroke="var(--color-magenta)" />
              <ellipse cx="0" cy="0" rx="44" ry="15" transform="rotate(32)" stroke="var(--color-volt)" />
            </svg>
            <span class="relative grad-text grad-scroll">FI</span>
            <Multiline99 strokeWidth={6} class="relative h-[1.05em] w-auto" />
          </a>
          <StatusReadout />
        </div>
        <nav aria-label="Main">
          <ul class="flex h-full items-stretch">
            {
              nav.map((item) => (
                <li class="flex border-l border-bone/20">
                  <a
                    href={item.href}
                    data-scramble
                    /* A fourth item pushes the header past 320px at the old
                       spacing — the whole row needed 385px, which silently
                       forced the layout viewport wider on small phones. Tighter
                       padding and tracking below sm buy it back; the row keeps
                       its 52px height, so tap targets are untouched. */
                    class="flex items-center px-2.5 py-3 font-mono text-[11px] tracking-[0.08em] hover:bg-bone hover:text-void active:bg-bone active:text-void sm:px-6 sm:text-xs sm:tracking-[0.2em]"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-bone/20 font-mono text-xs">
      <div class="grid grid-cols-1 sm:grid-cols-3">
        <p class="border-b border-bone/20 px-4 py-4 tracking-widest text-bone/60 sm:border-b-0 sm:border-r sm:px-6">
          © {year} FI99 — WE CREATE THINGS.
        </p>
        <!-- The [ SOCIALS — SOON ] placeholder that stood here is spent: the
             accounts exist as of 2026-08-09. Icons rather than three mono
             labels because three labels do not fit a third of a 320px row, and
             no padding on this cell — each anchor carries its own, so the tap
             target is the full 48px height by 48px wide rather than the 16px
             glyph, and the first icon still lines up with the copyright text
             above it. No `data-scramble` on these: it rewrites textContent,
             which would delete the SVG. -->
        <div class="flex min-h-12 items-stretch border-b border-bone/20 sm:justify-center sm:border-b-0 sm:border-r">
          <SocialLinks />
        </div>
        <p class="flex items-center px-4 py-4 tracking-widest text-bone/60 sm:justify-end sm:px-6">
          FI99.CA
        </p>
      </div>
    </footer>

    <!-- Persisted too: a swapped-in replacement would drop the GSAP tweens
         driving it and snap the crosshair back to the top-left corner. -->
    <div class="fi-cursor" aria-hidden="true" transition:persist></div>

    <script>
      import '../scripts/motion.js';
      import '../scripts/cursor.js';
      import '../scripts/gravity.js';
      import '../scripts/clock.js';
    </script>
  </body>
</html>
